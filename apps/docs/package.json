{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'PORT=\"${PORT:-3002}\"; rm -rf .next/dev; exec next dev -p \"$PORT\"'",
    "build": "node scripts/check-content-secrets.mjs && next build",
    "check:content-secrets": "node scripts/check-content-secrets.mjs",
    "test:security": "node --test scripts/content-security.test.mjs",
    "start": "sh -c 'PORT=\"${PORT:-3002}\"; exec next start -p \"$PORT\"'",
    "lint": "next lint",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-menubar": "^1.2.1",
    "@repo/site-shell": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-ui": "^16.17.10",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "20.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.14",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.23",
    "typescript": "^5.9.3"
  }
}
