{
  "name": "@ossinsight/sync-github-data",
  "version": "0.0.1",
  "description": "A CLI tool for fetching GitHub user/repo data and persist it to the TiDB Serverless cluster.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && prisma generate && pnpm run build:ts",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "start": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/index.js",
    "dev:start": "ts-node -r tsconfig-paths/register src/index.ts",
    "test:security": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register --test tests/security.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/async": "^3.2.26",
    "@types/luxon": "^3.7.6",
    "@types/node": "^18.19.130",
    "fastify-tsconfig": "^1.0.1",
    "pino-pretty": "^9.4.1",
    "prisma": "5.22.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5",
    "eslint": "^8.57.1"
  },
  "dependencies": {
    "@goparrot/geocoder": "^4.5.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^7.120.4",
    "async": "^3.2.6",
    "axios": "^0.34.0",
    "commander": "^9.5.0",
    "env-schema": "^5.2.1",
    "generic-pool": "^3.9.0",
    "lru-cache": "^7.18.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "octokit": "^5.0.5",
    "pino": "^8.21.0",
    "pino-sentry-transport": "^1.6.0",
    "pinyin-pro": "^3.29.5",
    "reflect-metadata": "^0.1.14",
    "yaml": "^2.9.1"
  }
}
