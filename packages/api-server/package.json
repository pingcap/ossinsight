{
  "name": "@ossinsight/api-server",
  "version": "1.0.0",
  "description": "The API server of OSSInsight.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "test": "__tests__"
  },
  "scripts": {
    "build:ts": "tsc",
    "dev": "NODE_ENV=development fastify start --options -p ${API_SERVER_PORT:-3450} -P --ignore-watch=.ts$ -L dist/logger.js -l info -w dist/app.js",
    "build": "rm -rf dist && npm run build:ts",
    "start": "fastify start --options --options -a 0.0.0.0 -p ${API_SERVER_PORT:-3450} -L dist/logger.js -l info dist/app.js",
    "gen:dev-public-api-docs": "fastify start -a 0.0.0.0 -p ${API_SERVER_PORT:-3450} -L dist/logger.js -l info dist/cmd/gen-docs.js",
    "gen:public-api-docs": "rm -f ../../configs/public_api/openapi.yaml && API_BASE_URL=https://api.ossinsight.io fastify start -a 0.0.0.0 -p ${API_SERVER_PORT:-3450} -L dist/logger.js -l info dist/cmd/gen-docs.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "watch:ts": "tsc -w",
    "test:security": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.security.config.js --maxWorkers=12",
    "worker": "NODE_ENV=production node --env-file=.env.worker dist/worker/main.js",
    "worker:check": "NODE_ENV=production node --env-file=.env.worker dist/worker/main.js --check",
    "test:runtime": "node --test tests/runtime-dependencies.test.cjs"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.4.0",
    "@fastify/env": "^7.0.1",
    "@fastify/etag": "^6.2.1",
    "@fastify/mysql": "^5.0.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/redis": "^8.0.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/url-data": "^6.0.5",
    "@lukesthl/ts-axios-digest-auth": "^1.0.5",
    "@mgcrea/fastify-request-logger": "^1.9.1",
    "@ossinsight/types": "workspace:^",
    "@sentry/node": "^7.120.4",
    "JSONStream": "^1.3.5",
    "async": "^3.2.6",
    "axios": "1.21.0",
    "bullmq": "^3.16.2",
    "fastify": "^5.12.8",
    "fastify-auth0-verify": "^4.1.4",
    "fastify-cli": "^7.4.1",
    "fastify-metrics": "^12.1.0",
    "fastify-plugin": "^6.0.1",
    "generic-pool": "^3.9.0",
    "ioredis": "^5.11.1",
    "jsonrepair": "^3.15.0",
    "liquidjs": "^10.30.1",
    "luxon": "^3.7.2",
    "mustache": "^4.2.0",
    "mysql2": "^3.24.6",
    "node-sql-parser": "5.4.0",
    "octokit": "^5.0.5",
    "openai": "^6.49.0",
    "pino": "9.14.0",
    "pino-pretty": "^9.4.1",
    "pino-sentry-transport": "^1.6.0",
    "prom-client": "^15.1.3",
    "promised-sqlite3": "^2.1.0",
    "proxy-addr": "2.0.8",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1",
    "yaml": "^2.9.1",
    "@ossinsight/sql-policy": "workspace:*"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "5.0.1",
    "@types/async": "^3.2.26",
    "@types/chance": "^1.1.8",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^18.19.130",
    "@types/proxy-addr": "2.0.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^2.1.1",
    "chance": "^1.1.13",
    "fastify-tsconfig": "^1.0.1",
    "glob": "^8.1.0",
    "jest": "^30.5.2",
    "json-schema-to-ts": "3.1.1",
    "json-schema-to-typescript": "^11.0.5",
    "randexp": "^0.5.3",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^9.12.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "ws": "^8.21.0"
  },
  "files": [
    "dist",
    "docker-start.sh"
  ]
}
