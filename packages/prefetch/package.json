{
  "name": "@ossinsight/prefetch",
  "version": "1.0.0",
  "description": "The query prefetch program for OSS Insight.",
  "main": "index.js",
  "scripts": {
    "build:ts": "tsc",
    "build": "rm -rf dist && pnpm run build:ts",
    "dev": "NODE_ENV=development node dist/index.js",
    "start": "node dist/index.js",
    "deploy": "pm2 start --cwd $(pwd) 'pnpm run start' --name 'ossinsight-prefetch'",
    "watch:ts": "tsc -w"
  },
  "keywords": [],
  "author": "Mini256",
  "license": "Apache-2.0",
  "dependencies": {
    "@ossinsight/api-server": "workspace:^",
    "@ossinsight/types": "workspace:^",
    "@sentry/node": "^7.120.4",
    "async": "^3.2.6",
    "commander": "^9.5.0",
    "cron": "^2.4.4",
    "cron-parser": "^4.9.0",
    "env-schema": "^5.2.1",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "node-schedule": "^2.1.2",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "pino-sentry-transport": "^1.6.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/async": "^3.2.26",
    "@types/cron": "^2.4.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^18.19.130",
    "@types/node-schedule": "^2.1.8",
    "fastify-tsconfig": "^1.0.1",
    "typescript": "^5.9.3"
  }
}
