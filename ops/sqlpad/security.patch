diff --git a/server/lib/aws-region.js b/server/lib/aws-region.js
new file mode 100644
index 0000000..369dfbd
--- /dev/null
+++ b/server/lib/aws-region.js
@@ -0,0 +1,13 @@
+// GHSA-j965-2qgj-vjmq: prevent an AWS region from changing endpoint routing.
+// Keep the region to one bounded DNS label, including GovCloud/FIPS regions.
+export function assertAwsRegion(region) {
+  if (
+    typeof region !== 'string' ||
+    region.length > 63 ||
+    /[^a-z0-9-]/.test(region) ||
+    !/^[a-z0-9]+(?:-[a-z0-9]+)+$/.test(region)
+  ) {
+    throw new Error('Invalid AWS region: use a region name such as us-east-1');
+  }
+  return region;
+}
diff --git a/server/test/lib/aws-region.js b/server/test/lib/aws-region.js
new file mode 100644
index 0000000..f4579ad
--- /dev/null
+++ b/server/test/lib/aws-region.js
@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import { assertAwsRegion } from '../../lib/aws-region.js';
+import AWS from 'aws-sdk';
+import athena from '../../drivers/athena/index.js';
+
+describe('AWS endpoint region validation', function () {
+  for (const region of [
+    'us-east-1',
+    'cn-north-1',
+    'us-gov-west-1',
+    'us-iso-east-1',
+    'eusc-de-east-1',
+    'fips-us-east-1',
+    'us-east-1-fips',
+  ]) {
+    it(`accepts ${region}`, function () {
+      assert.equal(assertAwsRegion(region), region);
+    });
+  }
+
+  for (const region of [
+    undefined,
+    null,
+    {},
+    '',
+    'https://example.invalid',
+    'us-east-1.example.invalid',
+    'us-east-1/../../',
+    'us-east-1@example.invalid',
+    'us-east-1:443',
+    'us-east-1?x=1',
+    'us-east-1#fragment',
+    'us-east-1\n',
+    'us-east-1\r\n',
+    'us-east-1\0',
+    ' us-east-1',
+    'us-east-1 ',
+    `us-${'a'.repeat(60)}-1`,
+  ]) {
+    it(`rejects unsafe region ${JSON.stringify(region)}`, function () {
+      assert.throws(() => assertAwsRegion(region), /Invalid AWS region/);
+    });
+  }
+});
+
+describe('Athena region validation at driver entry points', function () {
+  it('builds an Athena request with the patched UUID dependency without sending it', async function () {
+    const client = new AWS.Athena({
+      region: assertAwsRegion('us-east-1'),
+      credentials: {
+        accessKeyId: 'synthetic-access-key',
+        secretAccessKey: 'synthetic-secret-key',
+      },
+    });
+    const request = client.startQueryExecution({
+      QueryString: 'SELECT 1',
+      ResultConfiguration: {
+        OutputLocation: 's3://synthetic-test-bucket/results/',
+      },
+    });
+    await new Promise((resolve, reject) => {
+      request.build((error) => (error ? reject(error) : resolve()));
+    });
+    assert.equal(
+      request.httpRequest.endpoint.hostname,
+      'athena.us-east-1.amazonaws.com'
+    );
+    assert.match(request.params.ClientRequestToken, /^[a-f0-9-]{36}$/);
+  });
+
+  const connection = { awsRegion: 'us-east-1.example.invalid' };
+  const operations = {
+    schema: () => athena.getSchema(connection),
+    start: () => athena.startQueryExecution('SELECT 1', connection),
+    results: () => athena.runQuery('synthetic-execution-id', connection),
+    cancel: () => athena.cancelQuery('synthetic-execution-id', connection),
+  };
+  for (const [name, operation] of Object.entries(operations)) {
+    it(`rejects unsafe ${name} routing before mutating AWS configuration`, async function () {
+      const regionBefore = AWS.config.region;
+      await assert.rejects(async () => operation(), /Invalid AWS region/);
+      assert.equal(AWS.config.region, regionBefore);
+    });
+  }
+});
